          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的签名损坏"
          }
        }
      }
    },
    "%@ has no prefix at %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat kein Präfix unter %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n'a pas de préfixe à %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non ha un prefisso in %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处没有游戏容器。"
          }
        }
      }
    },
    "%@ is already listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist bereits aufgeführt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ figure déjà dans la liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già nell'elenco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在列表中。"
          }
        }
      }
    },
    "%@ is left from a rebuild that did not finish and may hold the only copy of the saves. Move it somewhere safe, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stammt von einer nicht abgeschlossenen Neuerstellung und enthält möglicherweise die einzige Kopie der Spielstände. Verschiebe es an einen sicheren Ort und versuche es dann erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ provient d'une reconstruction inachevée et contient peut-être la seule copie des parties sauvegardées. Déplacez-le en lieu sûr, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è rimasto da una ricostruzione non completata e potrebbe contenere l'unica copia dei salvataggi. Spostalo in un posto sicuro, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是上次未完成重建留下的文件，可能保存着唯一的游戏存档。请先将其移到安全位置，然后重试。"
          }
        }
      }
    },
    "%@ is missing the dyld entitlement" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fehlt das dyld-Entitlement"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque l'entitlement dyld à %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ manca l'entitlement dyld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 缺少 dyld 授权项"
          }
        }
      }
    },
    "%@ is not Steam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht Steam."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas Steam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Steam。"
          }
        }
      }
    },
    "%@ is not a Windows program. Pick an exe, msi, bat or cmd file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein Windows-Programm. Wähle eine exe-, msi-, bat- oder cmd-Datei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas un programme Windows. Choisissez un fichier exe, msi, bat ou cmd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un programma Windows. Scegli un file exe, msi, bat o cmd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Windows 程序。请选择 exe、msi、bat 或 cmd 文件。"
          }
        }
      }
    },
    "%@ is not a supported build. Supported: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist kein unterstützter Build. Unterstützt: %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n'est pas un build pris en charge. Pris en charge : %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è una build supportata. Supportate: %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持构建版本 %@。支持的版本：%@。"
          }
        }
      }
    },
    "%@ is not a valid copy of CrossOver." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist keine gültige CrossOver-Kopie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas une copie valide de CrossOver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è una copia valida di CrossOver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是有效的 CrossOver 应用。"
          }
        }
      }
    },
    "%@ is not signed by Valve. Expected TeamIdentifier=%@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist nicht von Valve signiert. Erwartet: TeamIdentifier=%2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n'est pas signé par Valve. Attendu : TeamIdentifier=%2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è firmato da Valve. Atteso TeamIdentifier=%2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 并非由 Valve 签名。预期 TeamIdentifier=%@。"
          }
        }
      }
    },
    "%@ is not the Steam bundle. Expected Identifier=%@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist nicht das Steam-Bundle. Erwartet: Identifier=%2$@."
          }
        },
        "fr" : {
          "stringUnit" : {

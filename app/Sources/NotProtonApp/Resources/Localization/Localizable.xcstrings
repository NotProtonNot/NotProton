    "Steam" : {
      "shouldTranslate" : false
    },
    "Steam at %@ isn't connected, so NotProton can't be removed from it. All other NotProton data is removed, except for Windows Games and prefixes." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in %@ non è collegato, quindi NotProton non può esserne rimosso. Tutti gli altri dati di NotProton vengono rimossi, tranne i giochi Windows e i prefissi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Steam 未连接，因此无法从中移除 NotProton。其他所有 NotProton 数据都会被移除，但 Windows 游戏及游戏容器除外。"
          }
        }
      }
    },
    "Steam at %@ isn't connected." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in %@ non è collegato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Steam 未连接。"
          }
        }
      }
    },
    "Steam client updates are allowed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam sono consentiti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已允许 Steam 客户端更新。"
          }
        }
      }
    },
    "Steam client updates are blocked." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam sono bloccati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已阻止 Steam 客户端更新。"
          }
        }
      }
    },
    "Steam client updates may break NotProton." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam potrebbero rendere NotProton inutilizzabile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 客户端更新可能导致 NotProton 无法使用。"
          }
        }
      }
    },
    "Steam client updates may break NotProton. If you don't want to wait for NotProton to be updated to be compatible with future Steam versions at the cost of not getting updates to the Steam client, you can stop the Steam client from updating itself." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam potrebbero rendere NotProton inutilizzabile. Se non vuoi aspettare che NotProton venga aggiornato per le future versioni di Steam, puoi impedire al client Steam di aggiornarsi, rinunciando però ai suoi aggiornamenti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 客户端更新可能导致 NotProton 无法使用。你可以阻止 Steam 自动更新，避免等待 NotProton 适配新版本，但这也意味着无法及时获得 Steam 客户端的功能改进和安全更新。"
          }
        }
      }
    },
    "Steam could not be fully restored. Please run Repair Steam again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile ripristinare completamente Steam. Esegui di nuovo Ripara Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未能完全恢复 Steam。请再次执行“修复 Steam”。"
          }
        }
      }
    },
    "Steam has a different copy of NotProton, installed by another account on this Mac. Update NotProton from that account, then try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ha una copia diversa di NotProton, installata da un altro account su questo Mac. Aggiorna NotProton da quell'account, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 中的另一份 NotProton 是由本机其他账户安装的。请使用该账户更新 NotProton，然后重试。"
          }
        }
      }
    },
    "Steam has not been set up for NotProton, and this account cannot change it. Install from the account that owns Steam." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam non è stato configurato per NotProton e questo account non può modificarlo. Installa dall'account a cui appartiene Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 尚未配置 NotProton，当前账户无权修改。请使用安装 Steam 的账户执行安装。"
          }
        }
      }
    },
    "Steam integration needs repair." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'integrazione con Steam va riparata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 集成需要修复。"
          }
        }
      }
    },
    "Steam is restored to its unmodified state and NotProton is removed, including the compatibility tool that lives inside the Steam folder. Windows games and Steam Play prefixes are not removed." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam viene riportato allo stato originale e NotProton viene rimosso, compreso lo strumento di compatibilità nella cartella di Steam. I giochi Windows e i prefissi di Steam Play non vengono rimossi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会将 Steam 恢复为未修改的状态，并移除 NotProton（包括 Steam 文件夹内的兼容工具）。不会删除 Windows 游戏及 Steam Play 游戏容器。"
          }
        }
      }
    },
    "Steam is running" : {
      "localizations" : {

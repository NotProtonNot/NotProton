    },
    "This build of NotProton carries no components at all." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser NotProton-Build enthält überhaupt keine Komponenten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce build de NotProton ne contient aucun composant."
          }
        },

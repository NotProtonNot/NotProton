    },
    "The %@ ntdll at %@ hashes %@ and build %@ expects %@. It is already patched, or from another CrossOver build." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$@-ntdll unter %2$@ hat den Hash %3$@, Build %4$@ erwartet %5$@. Sie ist bereits gepatcht oder stammt aus einem anderen CrossOver-Build."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ntdll %1$@ à %2$@ a le hachage %3$@ alors que le build %4$@ attend %5$@. Elle est déjà corrigée ou provient d'un autre build de CrossOver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hash dell'ntdll %1$@ in %2$@ è %3$@ e la build %4$@ si aspetta %5$@. Ha già la patch, oppure viene da un'altra build di CrossOver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 处的 %1$@ ntdll 的哈希值为 %3$@，但构建版本 %4$@ 预期为 %5$@。该文件可能已修补，或来自其他 CrossOver 版本。"
          }
        }
      }
    },
    "The %@ ntdll file alignment %@ is not a power of two." : {

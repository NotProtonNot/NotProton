    ", not supported" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", non supportata"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "，不受支持"
          }
        }
      }
    },
    "1 backup" : {
      "localizations" : {
        "it" : {

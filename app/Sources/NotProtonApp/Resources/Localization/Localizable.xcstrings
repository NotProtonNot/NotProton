    "The %@ cave at %@ is not empty. This ntdll is either already patched or not the build its hash claimed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$@-Cave bei %2$@ ist nicht leer. Diese ntdll ist entweder bereits gepatcht oder nicht der Build, den ihr Hash angibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

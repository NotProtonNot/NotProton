    },
    "NotProton could not download the files it needs from %@. Please try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton konnte die benötigten Dateien nicht von %@ laden. Bitte versuche es später erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton n'a pas pu télécharger les fichiers nécessaires depuis %@. Veuillez réessayer plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton non è riuscito a scaricare da %@ i file che gli servono. Riprova più tardi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton 无法从 %@ 下载所需文件。请稍后重试。"
          }
        }
      }
    },
    "NotProton could not reach %@'s servers. Please check your internet connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton konnte die Server von %@ nicht erreichen. Bitte prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {

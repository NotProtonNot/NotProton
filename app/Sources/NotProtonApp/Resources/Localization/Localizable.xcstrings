          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa build di NotProton non contiene nessun componente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的 NotProton 未包含任何组件。"
          }
        }
      }
    },
    "This can also fix issues where a game previously started/worked and does not work now, even if you did not switch CrossOver types." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann auch Probleme beheben, bei denen ein Spiel früher startete bzw. funktionierte und jetzt nicht mehr, selbst wenn du die CrossOver-Variante nicht gewechselt hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut aussi résoudre les cas où un jeu démarrait ou fonctionnait auparavant et ne fonctionne plus, même si vous n'avez pas changé de type de CrossOver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può anche risolvere i casi in cui un gioco prima si avviava o funzionava e ora no, anche se non hai cambiato tipo di CrossOver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使没有切换 CrossOver 类型，也可能修复游戏之前能运行、现在却无法运行的问题。"
          }
        }
      }
    },
    "This copy of NotProton cannot repair Steam. Please reinstall NotProton." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese NotProton-Kopie kann Steam nicht reparieren. Bitte installiere NotProton neu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie de NotProton ne peut pas réparer Steam. Réinstallez NotProton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa copia di NotProton non può riparare Steam. Reinstalla NotProton."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 NotProton 副本无法修复 Steam。请重新安装 NotProton。"
          }
        }
      }
    },
    "This package needs its files downloaded by hand, which NotProton cannot do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This package needs its files downloaded by hand, which NotProton cannot do."
          }
        },
        "fr" : {

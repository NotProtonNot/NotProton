    },
    "NotProton has been partially removed, because Steam at %@ cannot be found. Delete that copy of Steam and reinstall it to fully remove NotProton." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton wurde nur teilweise entfernt, weil Steam unter %@ nicht gefunden wurde. Lösche diese Steam-Kopie und installiere Steam neu, um NotProton vollständig zu entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton a été partiellement supprimé, car Steam est introuvable à %@. Supprimez cette copie de Steam et réinstallez-la pour supprimer complètement NotProton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton è stato rimosso solo in parte, perché Steam in %@ non si trova. Elimina quella copia di Steam e reinstallala per rimuovere del tutto NotProton."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton 仅被部分移除，因为找不到位于 %@ 的 Steam。请删除该 Steam 并重新安装，以完全移除 NotProton。"
          }
        }
      }
    },
    "NotProton has been removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton wurde entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton a été supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton è stato rimosso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton 已移除。"
          }
        }
      }
    },
    "NotProton has been removed. Steam could not be restored. Reinstall Steam from steampowered.com before using it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton wurde entfernt. Steam konnte nicht wiederhergestellt werden. Installiere Steam von steampowered.com neu, bevor du es wieder verwendest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton a été supprimé. Steam n'a pas pu être restauré. Réinstallez Steam depuis steampowered.com avant de l'utiliser à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton è stato rimosso. Non è stato possibile ripristinare Steam: reinstallalo da steampowered.com prima di usarlo di nuovo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton 已移除，但需要重新下载 Steam。请联网后再次执行“修复 Steam”。"
          }
        }
      }
    },
    "NotProton is installed in %@. Use Repair Steam to remove it before choosing another copy of Steam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotProton ist in %@ installiert. Entferne es mit „Steam reparieren“, bevor du eine andere Steam-Kopie wählst."
          }
        },
        "fr" : {
          "stringUnit" : {

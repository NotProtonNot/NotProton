          }
        }
      }
    },
    "The %@ detour goes to %@, below its cave at %@, so writing it would land in live code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der %1$@-Detour führt nach %2$@, unterhalb seiner Cave bei %3$@. Ihn zu schreiben würde aktiven Code treffen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le détour %1$@ pointe vers %2$@, sous sa cave à %3$@ : l'écrire atterrirait dans du code actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il detour %1$@ va a %2$@, sotto la sua cave a %3$@: scriverlo finirebbe nel codice in uso."

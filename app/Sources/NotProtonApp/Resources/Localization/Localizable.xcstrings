{
  "sourceLanguage" : "en",
  "strings" : {
    " NotProton can be deployed, but the CrossOver compatibility tool cannot be installed without a valid license." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " NotProton kann bereitgestellt werden, aber das CrossOver-Kompatibilitätstool lässt sich ohne gültige Lizenz nicht installieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " NotProton peut être déployé, mais l'outil de compatibilité CrossOver ne peut pas être installé sans licence valide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " NotProton può essere installato, ma lo strumento di compatibilità di CrossOver non può essere installato senza una licenza valida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 可以部署 NotProton，但没有有效许可证时无法安装 CrossOver 兼容工具。"
          }
        }
      }
    },
    " with %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " mit %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " avec %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " con %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（使用 %@）"
          }
        }
      }
    },
    "%@ and %@ both come from %@ but pin different hashes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ und %2$@ stammen beide aus %3$@, legen aber unterschiedliche Hashes fest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ et %2$@ proviennent tous deux de %3$@ mais fixent des hachages différents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ vengono entrambi da %3$@ ma fissano hash diversi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 和 %@ 均来自 %@，但指定了不同的哈希值。"
          }
        }
      }
    },
    "%@ at %@ spans %lld bytes, past the end of a %lld byte file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bei %2$@ umfasst %3$lld Bytes und reicht über das Ende einer %4$lld Byte großen Datei hinaus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ à %2$@ couvre %3$lld octets, au-delà de la fin d'un fichier de %4$lld octets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a %2$@ occupa %3$lld byte, oltre la fine di un file di %4$lld byte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 处的%1$@占用 %3$lld 字节，超出了文件的 %4$lld 字节长度。"
          }
        }
      }
    },
    "%@ carries no entitlements to extend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keine Entitlements, die erweitert werden könnten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne contient aucun entitlement à étendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha entitlement da estendere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不包含可扩展的授权项。"
          }
        }
      }
    },
    "%@ conflicts with %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ conflicts with %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ conflicts with %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è in conflitto con %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 与 %2$@ 冲突。"
          }
        }
      }
    },
    "%@ could not be copied out of the prefix. The prefix has been left as it was and nothing has been lost. Check free space and permissions, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht aus dem Präfix kopiert werden. Das Präfix wurde nicht verändert und nichts ist verloren gegangen. Prüfe den freien Speicherplatz und die Zugriffsrechte und versuche es dann erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas pu être copié hors du préfixe. Le préfixe est resté tel quel et rien n'a été perdu. Vérifiez l'espace libre et les autorisations, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile copiare %@ fuori dal prefisso. Il prefisso è rimasto com'era e non è andato perso nulla. Controlla lo spazio libero e i permessi, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从容器中复制 %@。容器保持原样，未丢失任何内容。请检查剩余空间和权限，然后重试。"
          }
        }
      }
    },
    "%@ could not be read as a property list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht als Property List gelesen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas pu être lu comme liste de propriétés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere %@ come property list."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将 %@ 读取为属性列表。"
          }
        }
      }
    },
    "%@ could not be read. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konnte nicht gelesen werden. %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n'a pas pu être lu. %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere %1$@. %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@。%@"
          }
        }
      }
    },
    "%@ could not be signed. " : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht signiert werden. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas pu être signé. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile firmare %@. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法对 %@ 签名。"
          }
        }
      }
    },
    "%@ could not be written. " : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht geschrieben werden. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas pu être écrit. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scrivere %@. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法写入 %@。"
          }
        }
      }
    },
    "%@ did not contain %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ enthielt %2$@ nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne contenait pas %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non conteneva %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中不包含 %@。"
          }
        }
      }
    },
    "%@ does not appear to have a prefix to back up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ scheint kein Präfix zu haben, das gesichert werden kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne semble pas avoir de préfixe à sauvegarder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non sembra avere un prefisso di cui fare il backup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 似乎没有可备份的游戏容器。"
          }
        }
      }
    },
    "%@ does not verify against its own signature. " : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stimmt nicht mit seiner eigenen Signatur überein. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne correspond pas à sa propre signature. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non corrisponde alla propria firma. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未通过自身签名验证。"
          }
        }
      }
    },
    "%@ failed with status %d." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist mit Status %2$d fehlgeschlagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a échoué avec le statut %2$d."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è riuscito (stato %2$d)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 执行失败，状态码为 %d。"
          }
        }
      }
    },
    "%@ failed with status %d: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist mit Status %2$d fehlgeschlagen: %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a échoué avec le statut %2$d : %3$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è riuscito (stato %2$d): %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 执行失败，状态码为 %d：%@"

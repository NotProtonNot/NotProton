          }
        }
      }
    },
    "The winebus.sys cave at %@ is not empty padding after the code, so writing the detour could overwrite live code." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cave di winebus.sys a %@ non è riempimento vuoto dopo il codice: scrivere il detour potrebbe sovrascrivere codice attivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "winebus.sys 在 %@ 处的代码空隙不是代码之后的空白填充；写入跳转补丁可能会覆盖现有代码。"
          }
        }
      }
    },
    "The winebus.sys hook site at %@ holds %@ instead of %@, so the offsets do not belong to this build." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",

# What both parsers have to produce for the fixtures beside this file, as the
# normalised form in dylib/feats/conf-format.md: one tab-separated line per field in
# the order read, and a "!" line where a file or a record was refused.
#
# Records run in file-name order, then in the order they appear in their file. The
# codes are shared; the wording each parser logs is its own.
#
# This is one pass over each directory, not a file at a time: ids and the 32-record
# cap are per directory, so the sections below run in file-name order and a record
# can collide with one in an earlier file. The cap itself is checked in featcheck
# rather than here, since 33 records of fixture would say nothing else.

== plugins/10-grouped.conf
NOTPROTON_HUD	label	Hud
NOTPROTON_HUD	description	Draws a HUD.
NOTPROTON_HUD	requires	code/hud/build/libhud.dylib
NOTPROTON_HUD	inject	1
NOTPROTON_HUD	env	HUD=1
NOTPROTON_HUD	description_on	Ctrl+Opt+H hides it.
NOTPROTON_HUD	description_on	Ctrl+Opt+G draws the graph.
NOTPROTON_ENV_HUD_POS	label	HUD position
NOTPROTON_ENV_HUD_POS	type	choice
NOTPROTON_ENV_HUD_POS	depends	NOTPROTON_HUD
NOTPROTON_ENV_HUD_POS	choice	tl = Top left
NOTPROTON_ENV_HUD_POS	choice	tr
NOTPROTON_ENV_HUD_SCALE	label	HUD size
NOTPROTON_ENV_HUD_SCALE	type	slider
NOTPROTON_ENV_HUD_SCALE	depends	NOTPROTON_HUD
NOTPROTON_ENV_HUD_SCALE	min	0.5
NOTPROTON_ENV_HUD_SCALE	max	2
NOTPROTON_ENV_HUD_SCALE	step	0.05
NOTPROTON_ENV_HUD_SCALE	default	1
NOTPROTON_ENV_HUD_SCALE	suffix	x
NOTPROTON_ENV_HUD_HZ	label	Pacing
NOTPROTON_ENV_HUD_HZ	type	slider
NOTPROTON_ENV_HUD_HZ	depends	NOTPROTON_HUD
NOTPROTON_ENV_HUD_HZ	default	off
NOTPROTON_ENV_HUD_HZ	choice	off = Off
NOTPROTON_ENV_HUD_HZ	choice	60 = 60 Hz

== plugins/20-single.conf
NOTPROTON_SOLO	label	Solo
NOTPROTON_SOLO	on	yes
NOTPROTON_SOLO	off	no
NOTPROTON_SOLO	overrides	dxgi=n,b
NOTPROTON_SOLO	stage	code/solo/dlls

# A header may be padded, a field may be separated by tabs, a "#" inside a value is
# part of it, and only the first "=" splits.
== plugins/30-comments-and-spacing.conf
NOTPROTON_SPACED	label	Spaced
NOTPROTON_SPACED	description	a # that is not a comment
NOTPROTON_SPACED	env	PATH_LIKE=a=b=c

== plugins/35-dup-across-files.conf
!	NOTPROTON_SOLO	duplicate-id

# A field before the first header drops the file, so the good record after it is lost
# too: there is no way to know which record the stray line was meant for.
== plugins/40-no-header.conf
!	plugins/40-no-header.conf	no-header


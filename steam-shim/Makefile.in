MODULE    = steam.exe
# Wine's own PE libc++. mingw's libstdc++ leaves std::basic_string and
# _Unwind_SjLj_Resume undefined.
IMPORTS   = $(CXX_PE_LIBS) user32 advapi32 shlwapi shell32 msi

EXTRADLLFLAGS = -mwindows -mcygwin -static-libgcc
# __WINESRC__ is re-added because WINE_EXTERNAL drops it, and ERR() and ARRAY_SIZE()
# are hidden without it. PATH_MAX is defined because mingw's limits.h has none.
EXTRADEFS = -DWINE_NO_LONG_TYPES -D__WINESRC__ -DPATH_MAX=4096 -include posix_compat.h

EXTRAINCL = \
	-I$(srcdir)/proton-headers/steamworks_sdk_142 \
	-I$(srcdir)/proton-headers/openvr/headers \
	-I$(srcdir)/proton-headers/wine/include

SOURCES = \
	jsoncpp.cpp \
	steam.cpp
